# Streamlit Community Cloud에 배포할 때 사용하는 Secrets 예시 파일입니다.
# 실제 값은 여기 적지 말고, Streamlit Cloud 앱 설정(Settings → Secrets)에 붙여넣으세요.
# 로컬에서 secrets 방식으로 테스트하려면 이 파일을 ".streamlit/secrets.toml"로 복사한 뒤
# 실제 키 값을 채우세요 (secrets.toml은 .gitignore에 등록되어 있어 git에는 올라가지 않습니다).

YOUTUBE_API_KEY = "여기에_실제_API_키_입력"

# (선택 A) 모두가 같은 코드 하나를 쓰는 방식. 워치리스트도 공용으로 공유됩니다.
# [users]를 아래에 설정했다면 ACCESS_CODE는 무시됩니다.
ACCESS_CODE = "원하는_접속_코드"

# (선택 B, 추천) 사람마다 다른 코드를 부여해서 각자 별도의 워치리스트를 갖게 하는 방식.
# 이 테이블이 하나라도 있으면 ACCESS_CODE 대신 이걸로 로그인을 처리합니다.
# 아래 예시처럼 "이름 = 그 사람 전용 코드" 를 원하는 만큼 추가하세요.
[users]
철수 = "철수전용코드"
영희 = "영희전용코드"
